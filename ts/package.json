{
  "name": "lane3000-ts",
  "version": "1.0.0",
  "description": "TypeScript driver and games for an Ingenico Lane/3000 over USB serial (RBA protocol)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "bun test --timeout 20000",
    "check": "bun run typecheck && bun run lint && bun run test",
    "lane": "bun src/cli.ts lane",
    "game-screen": "bun src/cli.ts game-screen",
    "snake": "bun src/cli.ts snake",
    "maze": "bun src/cli.ts maze",
    "life": "bun src/cli.ts life",
    "show-image": "bun src/cli.ts show-image",
    "io-demo": "bun src/cli.ts io-demo",
    "card-test": "bun src/cli.ts card-test",
    "light-test": "bun src/cli.ts light-test",
    "lock-probe": "bun src/cli.ts lock-probe",
    "maze-script": "bun src/cli.ts maze-script",
    "coin-grab": "bun src/cli.ts coin-grab",
    "skimmer-hunt": "bun src/cli.ts skimmer-hunt"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
